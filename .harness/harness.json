{
  "$schema": "./schema.json",
  "version": 1,
  "requiredFiles": [
    "AGENTS.md",
    "README.md",
    "harness.cmd",
    "docs/architecture.md",
    "docs/quality.md",
    ".harness/harness.json",
    "scripts/harness.ps1",
    "scripts/branch-policy.ps1",
    "tests/harness/branch-policy.tests.ps1",
    "tests/harness/migration-command.tests.ps1",
    "tests/harness/runtime-profile-isolation.tests.ps1"
  ],
  "gitPolicy": {
    "workingBranch": "main",
    "forbiddenBranchFragments": [
      "codex"
    ]
  },
  "steps": {
    "bootstrap": [
      {
        "name": "Locked dependency restore",
        "command": "dotnet",
        "args": ["restore", "KpiManagement.slnx", "--locked-mode", "--disable-parallel", "-m:1", "-p:BuildInParallel=false"]
      },
      {
        "name": "Build Playwright driver",
        "command": "dotnet",
        "args": ["build", "KpiManagement.slnx", "--no-restore", "--configuration", "Release", "-m:1", "-p:BuildInParallel=false"]
      },
      {
        "name": "Provision pinned Playwright Chromium",
        "command": "powershell.exe",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts/provision-playwright.ps1"]
      }
    ],
    "format": [
      {
        "name": "Verify C# formatting",
        "command": "dotnet",
        "args": ["format", "KpiManagement.slnx", "--no-restore", "--verify-no-changes"]
      }
    ],
    "lint": [
      {
        "name": "Build solution with analyzers",
        "command": "dotnet",
        "args": ["build", "KpiManagement.slnx", "--no-restore", "--configuration", "Release", "-m:1", "-p:BuildInParallel=false"]
      }
    ],
    "test": [
      {
        "name": "All .NET test projects",
        "command": "dotnet",
        "args": ["test", "KpiManagement.slnx", "--no-restore", "--configuration", "Release", "-m:1", "-p:BuildInParallel=false"]
      },
      {
        "name": "Integration guide contract",
        "command": "powershell.exe",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "tests/harness/integration-guide.tests.ps1"]
      },
      {
        "name": "Git branch policy tests",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "tests/harness/branch-policy.tests.ps1"
        ]
      },
      {
        "name": "Migration command contract",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "tests/harness/migration-command.tests.ps1"
        ]
      },
      {
        "name": "Runtime profile isolation contract",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "tests/harness/runtime-profile-isolation.tests.ps1"
        ]
      }
    ],
    "migrate": [
      {
        "name": "Apply declared PostgreSQL migrations",
        "command": "dotnet",
        "args": ["run", "--project", "src/Kpi.Migrator/Kpi.Migrator.csproj", "--no-restore", "--configuration", "Release"]
      }
    ]
  }
}
