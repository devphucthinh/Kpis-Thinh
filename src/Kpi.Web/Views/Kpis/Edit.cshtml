@model Kpi.Web.Controllers.EditKpiModel
@{ Layout = "_Layout"; }

<h1>Soạn KPI: @Model.Definition?.Code</h1>
<div asp-validation-summary="All"></div>

<form method="post" action="@(Model.VersionId == Guid.Empty ? "/Kpis/AddVersion" : "/Kpis/UpdateDraft")">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="DefinitionId" />
    <input type="hidden" asp-for="VersionId" />
    <input type="hidden" asp-for="ConcurrencyToken" />
    <label>Tên phiên bản <input asp-for="VersionName" /></label>
    <label>Mô tả <textarea asp-for="VersionDescription"></textarea></label>
    <label>Biến (mỗi dòng một mã) <textarea asp-for="Variables" id="formula-variables" placeholder="revenue&#10;target"></textarea></label>
    <label>Công thức <textarea asp-for="Source" id="formula-source" placeholder="revenue / target * 100"></textarea></label>
    <label>Ghi chú thay đổi <input asp-for="ChangeSummary" /></label>
    <button class="button" type="submit">@(Model.VersionId == Guid.Empty ? "Lưu phiên bản Draft" : "Cập nhật phiên bản Draft")</button>
</form>

<section id="formula-test-run">
    <h2>Test Run công thức</h2>
    <p>Chạy thử để xem kết quả; không lưu Evaluation hoặc Audit.</p>
    <div id="formula-test-inputs"></div>
    <button class="button" id="formula-test-button" type="button">Chạy Test Run</button>
    <pre id="formula-test-result" role="status"></pre>
</section>

<section>
    <h2>Phiên bản hiện có</h2>
    <ul>
    @foreach (var version in Model.Definition?.Versions ?? [])
    {
        <li>v@(version.VersionNumber) — @version.Status — <code>@version.Formula.Source</code></li>
    }
    </ul>
</section>

<section>
    <h2>Kiểm tra cú pháp</h2>
    <pre id="formula-diagnostics" role="alert"></pre>
    <h3>AST xem trước</h3>
    <pre id="formula-ast"></pre>
</section>

<script type="module">
import { attachFormulaEditor } from '/js/formula-editor.js';
attachFormulaEditor(
    document.getElementById('formula-source'),
    document.getElementById('formula-variables'),
    document.getElementById('formula-diagnostics'),
    document.getElementById('formula-ast'),
    document.getElementById('formula-test-inputs'),
    document.getElementById('formula-test-button'),
    document.getElementById('formula-test-result'));
</script>
