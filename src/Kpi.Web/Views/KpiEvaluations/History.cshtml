@model Kpi.Web.ViewModels.KpiEvaluationPageVm
@{ Layout = "_Layout"; ViewData["Title"] = "Evaluation History"; ViewData["ActiveNav"] = "evaluations"; }

<div class="page-title"><div><div class="muted">KPI EVALUATION</div><h1>Evaluation History</h1><p class="subtitle">@Model.DefinitionName · @Model.DefinitionCode · công thức snapshot được bảo toàn.</p></div><a class="button" href="/KpiEvaluations/Create?definitionId=@Model.DefinitionId&activationId=@Model.ActivationId">Tính evaluation mới</a></div>

<div class="card" data-history-limit="25"><div class="muted">CURRENT KPI EVALUATION</div><h2>Current KPI Evaluation</h2>@if (Model.Current is null) { <p class="subtitle">Chưa có Evaluation thành công.</p> } else { <div class="panel"><strong>@Model.Current.OutcomeText</strong><div class="muted">@Model.Current.EvaluatedAt.ToLocalTime() · v@Model.Current.VersionId</div></div> }</div>

<div class="card" style="margin-top:18px;"><div class="muted">IMMUTABLE HISTORY · LATEST 25</div><h2>Evaluation Attempts</h2><p class="subtitle">Correction tạo một <strong>Superseding Evaluation</strong>; Evaluation gốc vẫn bất biến.</p><div style="overflow:auto;"><table><thead><tr><th>Thời điểm</th><th>Outcome</th><th>Inputs</th><th>Formula</th><th>Quan hệ</th><th></th></tr></thead><tbody>@foreach (var item in Model.Attempts) { <tr><td>@item.EvaluatedAt.ToLocalTime()</td><td>@await Html.PartialAsync("_StatusBadge", item.OutcomeKind)<div>@item.OutcomeText</div></td><td><code>@string.Join(", ", item.Inputs.Select(x => $"{x.Key}={x.Value}"))</code></td><td><code>@item.FormulaSource</code></td><td>@if(item.SupersedesId is not null){<span>Superseding Evaluation</span>}else{<span>Original</span>}</td><td>@if(item.IsCurrent){<span class="status-badge status-success">Current</span>}@if(item.OutcomeKind == "Success" && item.SupersedesId is null && item.ActivationId is not null){<a href="/KpiEvaluations/Correct?definitionId=@Model.DefinitionId&predecessorId=@item.Id">Correction</a>}</td></tr> }</tbody></table></div></div>
