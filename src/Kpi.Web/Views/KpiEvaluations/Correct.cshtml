@model Kpi.Web.ViewModels.KpiCorrectionPageVm
@{ Layout = "_Layout"; ViewData["Title"] = "Correction"; ViewData["ActiveNav"] = "evaluations"; var predecessor = Model.Predecessor; }

<div class="page-title"><div><div class="muted">SUPERSEDING EVALUATION</div><h1>Correction</h1><p class="subtitle">Evaluation gốc bất biến; kết quả mới sẽ tạo Superseding Evaluation và diff.</p></div><a class="button secondary" href="/KpiEvaluations/History?definitionId=@Model.History.DefinitionId">Quay lại history</a></div>
<div class="card"><div class="muted">PREDECESSOR</div><h2>@predecessor.OutcomeText</h2><p>@predecessor.EvaluatedAt.ToLocalTime() · @predecessor.FormulaSource</p><ul>@foreach(var input in predecessor.Inputs){<li><code>@input.Key = @input.Value</code></li>}</ul></div>
<div class="card" style="margin-top:18px;"><form method="post" action="/KpiEvaluations/Correct">@Html.AntiForgeryToken()<input type="hidden" name="DefinitionId" value="@Model.History.DefinitionId" /><input type="hidden" name="VersionId" value="@predecessor.VersionId" /><input type="hidden" name="ActivationId" value="@predecessor.ActivationId" /><input type="hidden" name="PredecessorId" value="@predecessor.Id" /><h2>Giá trị thay thế</h2>@foreach(var variable in Model.History.Variables){<label>@variable.DisplayName (@variable.Code)<input name="Inputs[@variable.Code]" value="@predecessor.Inputs.GetValueOrDefault(variable.Code)" /></label>}<label>Lý do correction <textarea name="Reason" required placeholder="Nêu rõ vì sao cần sửa kết quả"></textarea></label><button class="button" type="submit" @(Model.CanCorrect ? null : "disabled")>Tạo Superseding Evaluation</button></form></div>
<div class="panel" style="margin-top:18px;"><strong>Diff</strong><p class="subtitle">Sau khi lưu, lịch sử sẽ hiển thị changed inputs, old result, new result và reason; evaluation gốc không bị thay thế.</p></div>
