@model IReadOnlyList<Kpi.Domain.Periods.KpiPeriod>
@{ Layout = "_Layout"; }
<div class="page-title"><h1>Kỳ KPI</h1><a class="button" href="/KpiPeriods/Create">Tạo kỳ</a></div>
<table><thead><tr><th>Mã kỳ</th><th>Bắt đầu</th><th>Kết thúc</th><th>Trạng thái</th></tr></thead><tbody>@foreach (var period in Model) { <tr><td>@period.Code</td><td>@period.StartsAt.LocalDateTime</td><td>@period.EndsAt.LocalDateTime</td><td>@period.Status</td></tr> }</tbody></table>
