@model IReadOnlyList<Kpi.Web.ViewModels.KpiPeriodListItemVm>
@{ Layout = "_Layout"; ViewData["Title"] = "Kỳ KPI"; ViewData["ActiveNav"] = "periods"; }

<div class="page-title"><div><div class="muted">KPI PERIOD PLAN</div><h1>Kỳ KPI</h1><p class="subtitle">Lập kế hoạch, đóng băng lựa chọn và kích hoạt đúng thời điểm.</p></div><a class="button" href="/KpiPeriods/Create">+ Tạo kỳ KPI</a></div>

@if (Model.Count == 0)
{
    <div class="empty-state" data-period-stepper>Chưa có kỳ KPI. Tạo kỳ đầu tiên để chọn các KPI Version được phát hành.</div>
}
else
{
    <div class="card" style="padding:0;overflow:auto;">
        <table>
            <thead><tr><th>Kỳ</th><th>Cadence</th><th>Thời gian</th><th>KPIs</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
            @foreach (var period in Model)
            {
                <tr data-period-stepper>
                    <td><a href="/KpiPeriods/Details/@period.Id"><strong>@period.Code</strong></a><div class="muted">@period.Name</div></td>
                    <td>@period.Cadence</td>
                    <td>@period.StartsAt.ToLocalTime().ToString("dd/MM/yyyy") — @period.EndsAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                    <td>@period.SelectionCount selected · @period.ActivationCount active</td>
                    <td>@await Html.PartialAsync("_StatusBadge", period.Status.ToString())</td>
                    <td><a class="button secondary" href="/KpiPeriods/Details/@period.Id">Mở kỳ</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
